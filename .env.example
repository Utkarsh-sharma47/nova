# Copy to .env and fill locally. Never commit real values.

# Database
# DATABASE_URL=postgresql+psycopg://nova:nova@localhost:5432/nova

# API auth (Part 1 demo token — generate locally)
# API_AUTH_TOKEN=

# LLM (provider-agnostic; use mock in CI/local without keys)
# LLM_PROVIDER=mock
# LLM_MODEL=
# LLM_API_KEY=

# Observability
# LOG_LEVEL=INFO
