# Copy to .env and replace placeholders locally. Never commit real values.
#
# Required for docker compose up:
#   POSTGRES_PASSWORD, API_AUTH_TOKEN (non-placeholder)
#
# Production (APP_ENV=production) additionally requires:
#   - API_AUTH_TOKEN length >= 24
#   - DATABASE_URL without weak default passwords
#   - CORS_ORIGINS without "*"
#   - LLM_API_KEY when LLM_PROVIDER is not mock

POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=nova
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=8080
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=nova-api
API_AUTH_TOKEN=replace-with-a-long-random-token
DOCUMENT_STORAGE_PATH=/var/lib/nova/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
MAX_REQUEST_BODY_BYTES=12582912
ALLOWED_MIME_TYPES=application/pdf,text/plain,image/png,image/jpeg
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DB_WAIT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Optional: set LLM_PROVIDER=openai and LLM_API_KEY to enable live vision/text extraction.
# Without credentials, Nova falls back to MockLLM (deterministic CI/demo).
# Recommended vision-capable model example: LLM_MODEL=gpt-4o-mini
