# Copy to .env and fill locally. Never commit real values.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (required)
DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova

# API auth (Part 1 demo token — generate a strong value locally)
API_AUTH_TOKEN=local-dev-token-not-for-production

# Document storage
DOCUMENT_STORAGE_PATH=./data/uploads
MAX_DOCUMENT_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg,image/tiff,text/plain

# LLM placeholders (Phase 3 does not call providers)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
