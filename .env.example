# Copy to .env and fill locally. Never commit real values.
# Workflow: cp .env.example .env && docker compose up --build

# --- Compose / Postgres ---
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova
POSTGRES_PORT=5432

# --- API ---
# Inside Compose the host is `db`. For host-run API use localhost.
DATABASE_URL=postgresql+psycopg://nova:nova@db:5432/nova
API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=nova-api
# API_AUTH_TOKEN=

# LLM (provider-agnostic; use mock without keys)
LLM_PROVIDER=mock
# LLM_MODEL=
# LLM_API_KEY=

# Ops
DB_WAIT_SECONDS=60
DATABASE_CONNECT_TIMEOUT_SECONDS=5
