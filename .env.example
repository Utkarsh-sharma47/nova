# Copy this file to `.env` and fill in values locally.
# Never commit real credentials. `.env` is gitignored.
#
# Application and infrastructure variables will be added here as
# backend, frontend, database, and external services are introduced.
# Until then this file documents the expected local-secrets pattern.

# Example (placeholders only — replace when services exist):
# NOVA_ENV=development
# DATABASE_URL=postgresql://user:password@localhost:5432/nova
# OPENAI_API_KEY=replace-me
