# Copy to .env and replace placeholders locally. Never commit real values.
POSTGRES_USER=nova
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=nova
POSTGRES_PORT=5432
API_PORT=8000
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=nova-api
API_AUTH_TOKEN=replace-with-a-long-random-token
DOCUMENT_STORAGE_PATH=/var/lib/nova/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=application/pdf,text/plain
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DB_WAIT_SECONDS=60

# Host-only / non-Compose tools may set DATABASE_URL. Compose builds the API
# URL from POSTGRES_* targeting the `db` service hostname automatically.
# DATABASE_URL=postgresql+psycopg://nova:replace-me@127.0.0.1:5432/nova

# Phase 4+ placeholders; Phase 3 never calls an LLM.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
