# Base URL for Nova API (no trailing slash).
# Use http://localhost:8000 for Vite local development against a host API.
# Use an empty value for same-origin deployments (Compose nginx proxy).
VITE_API_BASE_URL=http://localhost:8000

# Local demo auth token — sent as Bearer and X-API-Key when set.
# Must match API_AUTH_TOKEN. Never commit real production secrets.
VITE_API_AUTH_TOKEN=your-api-key-here
